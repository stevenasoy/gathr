# dependencies
node_modules

# lockfiles from other package managers — this repo is npm workspaces and CI
# runs `npm ci`, so package-lock.json is the only lockfile we track
pnpm-lock.yaml
yarn.lock

# build output
dist

# environment — never commit real env files; only .env.example variants are tracked
.env.*.local
!.env.example
!.env.*.example

# secrets / key material — never commit private keys, certs, or service-account JSON
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*service-account*.json

# OS
.DS_Store

# legacy
/video-ad
# dev scratch — automated screenshots / driver script
drive-*.png
drive.mjs

# isolated implementation worktrees
.worktrees/

# playwright output
test-results
config.bat
